# Frontend (Vite) — set by `npx convex dev` into .env.local
VITE_CONVEX_URL=https://<your-new-one-hub-deployment>.convex.cloud
VITE_CONVEX_SITE_URL=https://<your-new-one-hub-deployment>.convex.site

# Convex deployment environment variables (set with `npx convex env set NAME value`, NEVER commit real values)
# SITE_URL=https://hub.example.co.za
# JWT_PRIVATE_KEY / JWKS  -> generated by `npx @convex-dev/auth`
# ONEHUB_BOOTSTRAP_ADMIN_EMAIL=you@company.co.za   (only this email may create the very first Super Admin account)
# RESEND_API_KEY=re_...                            (from ONE HUB's OWN Resend account, "Sending access" only; see docs/RESEND_SETUP.md)
# RESEND_WEBHOOK_SECRET=whsec_...                  (Resend webhook -> https://<deployment>.convex.site/resend/webhook)
# ONEHUB_EMAIL_FROM='"ONE Property Holdings | Internal Communications" <notifications@hub.example.co.za>'
# ONEHUB_EMAIL_REPLY_TO=directors@example.co.za    (optional, a monitored mailbox)
# ONEHUB_EMAIL_DAILY_LIMIT=100 / ONEHUB_EMAIL_MONTHLY_LIMIT=3000   (defaults = Resend free plan; 0 = no cap)
# ONEHUB_EMAIL_MODE=log                            (log = never send, just record; test = send only to ONEHUB_EMAIL_TEST_RECIPIENT; live = send)
# ONEHUB_EMAIL_TEST_RECIPIENT=you@company.co.za
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY             (web push, Phase 6)
